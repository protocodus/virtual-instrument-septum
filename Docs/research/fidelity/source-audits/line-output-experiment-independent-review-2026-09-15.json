    "source_text": "#include <array>\n#include <cmath>\n#include <cstdlib>\n#include <cstdint>\n#include <iomanip>\n#include <iostream>\n#include \"OriginalAnalogOutput.h\"\n#include \"AnalogOutput.h\"\n\nint main() {\n    constexpr int count=20000;\n    int mismatch=0, resetMismatch=0, independenceMismatch=0, zeroRight=0;\n    double bypassMax=0, resetMax=0;\n    const auto input=[](int n) {return n==0 ? 1.0 : .4*std::sin(n*.137)+.2*std::cos(n*.0093);};\n    unsetenv(\"SEPTUM_LINE_FRACTION\");\n    original_septum::AnalogOutput original;\n    septum::AnalogOutput disabled;\n    original.prepare(44100); disabled.prepare(44100);\n    for(int n=0;n<count;++n) {\n        double a=original.processSample(input(n)), b=disabled.processSample(input(n));\n        mismatch+=(a!=b); bypassMax=std::max(bypassMax,std::abs(a-b));\n    }\n    for(const char* fraction:{\"0.1\",\"0.5\",\"1\"}) {\n        setenv(\"SEPTUM_LINE_FRACTION\",fraction,1);\n        septum::AnalogOutput used,fresh,single;\n        std::array<septum::AnalogOutput,2> stereo;\n        used.prepare(44100); fresh.prepare(44100); single.prepare(44100);\n        for(auto& p:stereo) p.prepare(44100);\n        for(int n=0;n<count;++n) used.processSample(input(n));\n        used.reset();\n        for(int n=0;n<count;++n) {\n            double a=used.processSample(input(n)),b=fresh.processSample(input(n));\n            resetMismatch+=(a!=b);resetMax=std::max(resetMax,std::abs(a-b));\n            double l=stereo[0].processSample(input(n)), rr=stereo[1].processSample(0.0);\n            independenceMismatch+=(l!=single.processSample(input(n))); zeroRight+=(rr!=0.0);\n        }\n    }\n    septum::analog_output_detail::Oversampling8 oversampler;\n    int innerCalls=0;\n    for(int n=0;n<100;++n) oversampler.process(input(n),[&](double x){++innerCalls;return x;});\n    std::cout<<std::setprecision(17)<<\"{\\\"bypass_samples\\\":\"<<count<<\",\\\"bypass_mismatches\\\":\"<<mismatch\n        <<\",\\\"bypass_max_abs\\\":\"<<bypassMax<<\",\\\"reset_samples\\\":\"<<3*count<<\",\\\"reset_mismatches\\\":\"<<resetMismatch\n        <<\",\\\"reset_max_abs\\\":\"<<resetMax<<\",\\\"stereo_samples\\\":\"<<3*count<<\",\\\"stereo_left_mismatches\\\":\"<<independenceMismatch\n        <<\",\\\"stereo_right_nonzero\\\":\"<<zeroRight<<\",\\\"circuit_calls_per_100_host_samples\\\":\"<<innerCalls<<\"}\\n\";\n    return mismatch||resetMismatch||independenceMismatch||zeroRight||innerCalls!=800;\n}\n",
