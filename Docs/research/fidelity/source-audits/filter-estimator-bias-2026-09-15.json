  "wav_sha256": {
    "k12-static-lp24.wav": "ebb0d749984a628591e5968df1abd70097bd48877ca8bdeb2b542bb8c03c1945",
    "production-static-lp24.wav": "ecb4f6869cf55cc4a5b45d915c429592bc2e622f26338df6073d4121eeb28eeb",
    "production-dynamic-lp12.wav": "607589710ba6c4dcd2a36f38f06382b36bf333ee343d9f42919f056cbc967ae5",
    "k12-dynamic-lp24.wav": "f55ad25bfd31e4937faa3a3a9fd67f6789808c53fc189eda23c0178b3b85b045",
    "k12-dynamic-lp12.wav": "450c7c6064349f28a28ed72379361c01f71e0f5bcfc7f3c62fcee62896d21258",
    "production-static-lp12.wav": "89228c44ddb7b52fc9837c373d7e46a3da278f664fa6b37d9f39deb88ea1d75e",
    "k12-static-lp12.wav": "37337b87d17cce491baa83fe87642ae2161ea4c89266fa85514f083f89fc59ec",
    "production-dynamic-lp24.wav": "a9d9e9c99acbbf348f871d5718b01307648bb61fe1b862b15001873e71a23874"
  },
  "renderer_source": "#include \"DSP/SeptumEngine.h\"\n#include <cmath>\n#include <cstdint>\n#include <fstream>\n#include <iomanip>\n#include <iostream>\n#include <vector>\n\nvoid word(std::ostream& stream, uint32_t x, int count = 4)\n{ for (int i=0; i<count; ++i) stream.put(char((x >> (i*8)) & 255)); }\nvoid wav(const std::string& path, const std::vector<float>& y)\n{\n    std::ofstream out(path, std::ios::binary);\n    out.write(\"RIFF\",4); word(out,36+uint32_t(y.size()*4)); out.write(\"WAVEfmt \",8);\n    word(out,16); word(out,3,2); word(out,1,2); word(out,44100); word(out,44100*4);\n    word(out,4,2); word(out,32,2); out.write(\"data\",4); word(out,uint32_t(y.size()*4));\n    out.write(reinterpret_cast<const char*>(y.data()),std::streamsize(y.size()*4));\n}\nint main(int argc,char**argv)\n{\n    if(argc!=2) return 2;\n    constexpr int rate=44100;\n    std::cout<<std::setprecision(15)<<\"decay_seconds=\"<<septum::mapping::filterDecaySeconds(63)\n             <<\" initial_cutoff_over_fundamental=\"<<septum::mapping::cutoffHz(34)*16/261.6255653005986<<\"\\n\";\n    for(bool candidate:{false,true}) for(bool moving:{false,true}) for(int slope:{12,24})\n    {\n        septum::Engine engine;\n        if(candidate)\n        {\n            auto calibration=septum::Engine::defaultTimbreCalibration();\n            calibration.filterEnabled=true;\n            calibration.secondStageIndependent=true;\n            calibration.resonanceDamping.fill(1.2);\n            calibration.secondStageDamping.fill(1.2);\n            if(!engine.setTimbreCalibration(calibration)) return 3;\n        }\n        engine.prepare(rate,256);\n        septum::Patch patch;\n        auto& tone=patch.upper;\n        tone.osc1.wave=septum::Waveform::Saw;\n        tone.balance=-63;\n        tone.filterType=septum::FilterType::Lpf;\n        tone.filterSlope=slope==12?septum::FilterSlope::Db12:septum::FilterSlope::Db24;\n        tone.cutoff=34;\n        tone.keyFollow=100;\n        tone.resonance=tone.cutoffVelocitySens=0;\n        tone.filterEnvAttack=0; tone.filterEnvDecay=63;\n        tone.filterEnvSustain=moving?0:127; tone.filterEnvDepth=21;\n        tone.filterEnvRelease=0;\n        tone.level=50; tone.levelVelocitySens=0;\n        tone.ampEnvAttack=0; tone.ampEnvDecay=0; tone.ampEnvSustain=127; tone.ampEnvRelease=0;\n        tone.lfo1.depth1=tone.lfo1.depth2=tone.lfo2.depth1=tone.lfo2.depth2=0;\n        patch.delayOn=patch.reverbOn=false;\n        engine.setPatch(patch); engine.reset();\n        const int notes[]={24,36,29,31,57};\n        std::vector<float> left(10*rate),right(left.size());\n        for(int n=0;n<5;++n)\n        {\n            engine.noteOnDirect(notes[n],100);\n            engine.process(left.data()+n*2*rate,right.data()+n*2*rate,rate);\n            engine.noteOffDirect(notes[n]);\n            engine.process(left.data()+(n*2+1)*rate,right.data()+(n*2+1)*rate,rate);\n        }\n        const std::string name=std::string(candidate?\"k12\":\"production\")+\"-\"+(moving?\"dynamic\":\"static\")+\"-lp\"+std::to_string(slope);\n        wav(std::string(argv[1])+\"/\"+name+\".wav\",left);\n        std::cout<<name<<\" latency=\"<<engine.latencySamples()<<\"\\n\";\n    }\n}\n",
  "analysis_source": "import sys,json,hashlib\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.io import wavfile\nfrom scipy.optimize import least_squares\n\nROOT=Path(__file__).resolve().parents[3]\nsys.path.insert(0,str(ROOT/'Tools'))\nimport analyze_deepsonic_filter as target\n\nFOLDER=Path(__file__).resolve().parent\nNOTES=(24,36,29,31,57)\nOFFSETS=(.08,.16,.24,.32)\n\ndef sha(path):return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\ndef run(label,moving):\n    rows=[]\n    for slope in (12,24):\n        sr,y=wavfile.read(FOLDER/f'{label}-{moving}-lp{slope}.wav')\n        assert sr==44100 and np.isfinite(y).all()\n        for index,note in enumerate(NOTES):\n            on=index*2\n            f0=440*2**((note-69)/12)\n            for offset in OFFSETS:\n                for shift,width in ((0,.08),(-.01,.08),(.01,.08),(0,.10)):\n                    center=on+offset+shift+93/sr\n                    row=target.measure(y,sr,center,width,f0)\n                    rows.append(dict(slope=slope,note=note,on=on,offset=offset,shift=shift,width=width,\n                                     fundamental_hz=f0,training=note==36,**row))\n    fit_rows=[r for r in rows if r['training'] and r['shift']==0 and r['width']==.08]\n    def residual(p):\n        ks=np.exp(p[:2])\n        return np.concatenate([target.errors(row,np.exp(cutoff),ks[:row['slope']//12])[target.mask(row)]\n            for row,cutoff in zip(fit_rows,p[2:])])\n    fitted=least_squares(residual,np.log([1.7,1.2]+[r['fundamental_hz']*5 for r in fit_rows]),\n        bounds=(np.log([.3,.3]+[r['fundamental_hz']*.5 for r in fit_rows]),\n                np.log([3.,3.]+[r['fundamental_hz']*20 for r in fit_rows])),\n        xtol=1e-12,ftol=1e-12,gtol=1e-12)\n    ks=np.exp(fitted.x[:2]).tolist()\n    models={name:target.model_summary(rows,k) for name,k in\n        [('production',[2.,1.2]),('k12',[1.2,1.2]),('recovered',ks)]}\n    result=dict(known_dampings=[2.,1.2] if label=='production' else [1.2,1.2],\n        recovered_dampings=ks,models=models,observations=rows,\n        max_harmonic_fit_residual=max(r['fit_residual_power'] for r in rows))\n    print(label,moving,ks,'maxresidual',result['max_harmonic_fit_residual'],flush=True)\n    for name,model in models.items(): print(name,model['summary'],flush=True)\n    return result\n\nresult=dict(schema_version=1,source_hashes={p.name:sha(p) for p in (FOLDER/'DSP').glob('*') if p.is_file()},\n            renderer_source_sha256=sha(FOLDER/'render.cpp'),renderer_sha256=sha(FOLDER/'render'),\n            parent_estimator_sha256=sha(ROOT/'Tools/analyze_deepsonic_filter.py'),\n            analysis_sha256=sha(__file__),cases={})\nfor label in ('production','k12'):\n    for moving in ('static','dynamic'):result['cases'][label+'-'+moving]=run(label,moving)\n(FOLDER/'results.json').write_text(json.dumps(result,indent=2)+'\\n')\n"
}
