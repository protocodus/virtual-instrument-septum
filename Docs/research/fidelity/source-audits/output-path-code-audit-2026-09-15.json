  "probe_source": "#include \"Source/DSP/SeptumEngine.cpp\"\n#include <iomanip>\n#include <iostream>\nint main() {\n  std::cout<<std::setprecision(17)<<\"{\\\"analytic_response\\\":[\";\n  bool first=true;\n  for(double hz:{.329,20.,40.,100.,1000.,5000.,10000.,15000.,20000.}) {\n    if(!first)std::cout<<',';first=false; auto r=septum::AnalogOutput::analogResponse(hz);\n    std::cout<<\"{\\\"hz\\\":\"<<hz<<\",\\\"magnitude_db\\\":\"<<20*std::log10(std::abs(r))<<\",\\\"phase_degrees\\\":\"<<std::arg(r)*180/3.14159265358979323846<<'}';\n  }\n  std::cout<<\"],\\\"linearity\\\":[\";first=true;\n  for(double scale:{.01,.1,2.5,10.}) {\n    septum::AnalogOutput a,b;a.prepare(44100);b.prepare(44100);double e=0,xx=0,max=0;\n    for(int n=0;n<44100;++n) {\n      double t=n/44100.;double x=(n<22050?1.:.17)*(.6*std::sin(2*3.14159265358979323846*41*t)+.2*std::cos(2*3.14159265358979323846*1013*t)+.1*std::sin(2*3.14159265358979323846*17317*t));\n      double y=a.processSample(x), z=b.processSample(scale*x), err=z-scale*y;e+=err*err;xx+=scale*scale*y*y;max=std::max(max,std::abs(err));\n    }\n    if(!first)std::cout<<',';first=false;\n    std::cout<<\"{\\\"input_scale\\\":\"<<scale<<\",\\\"relative_rms_difference\\\":\"<<std::sqrt(e/xx)<<\",\\\"maximum_abs_difference\\\":\"<<max<<'}';\n  }\n  std::cout<<\"],\\\"actual_output_limiter\\\":[\";first=true;\n  for(double x:{0.,.1,.5,.899999,.9,1.,1.2,2.,2.5,10.}) {\n    if(!first)std::cout<<',';first=false;\n    std::cout<<\"{\\\"input\\\":\"<<x<<\",\\\"output\\\":\"<<septum::outputLimit(x)<<'}';\n  }\n  std::cout<<\"],\\\"gain_normalization_db\\\":\"<<20*std::log10(2.5)<<\",\\\"voice_headroom_db\\\":\"<<20*std::log10(septum::mapping::voiceHeadroom)<<\"}\\n\";\n}\n",
